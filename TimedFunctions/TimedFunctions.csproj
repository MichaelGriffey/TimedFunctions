<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- ✅ NuGet Metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>TimedFunction</PackageId>
    <Version>1.0.1</Version>
    <Authors>Michael Aaron Griffey</Authors>
    <Company>homesickanvil.com</Company>
    <Description>Lightweight .NET helper to run synchronous or asynchronous functions with configurable timeouts and cancellation support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MichaelGriffey/TimedFunctions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MichaelGriffey/TimedFunctions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>timeout task cancellation async await utility</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
